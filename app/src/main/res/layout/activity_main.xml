<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="#91D9AE"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

<!--    Below is a linear layout that holds our view -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="14dp"
        android:orientation="vertical">

<!--     Below is a Textview   -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Health and Wellness App"
            android:textSize="45sp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textColor="#FE2C2828"/>

<!--        Below is an Image -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/image2"/>

        <com.google.android.gms.ads.AdView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/adView"
            app:adSize="BANNER"
            app:adUnitId="ca-app-pub-3940256099942544/6300978111"/>


<!--        Below is button number one  -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/healthy_recipes"
            android:text="📥Healthy Recipes"
            android:textSize="20sp"
            android:backgroundTint="@color/cardview_dark_background"
            android:layout_marginTop="15dp"/>

<!--        Below is button number two  -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/nutrition_advice"
            android:text="🍎Nutrition Advice"
            android:textSize="20sp"
            android:backgroundTint="@color/cardview_dark_background"
            android:layout_marginTop="10dp"/>

<!--        Below is button number three -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/meditation"
            android:text="🧘🏽‍♂️Meditation"
            android:textSize="20sp"
            android:backgroundTint="@color/cardview_dark_background"
            android:layout_marginTop="10dp"/>

<!--        Below is button number four -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/hydration_alert"
            android:text="💦Hydration Alert"
            android:textSize="20sp"
            android:backgroundTint="@color/cardview_dark_background"
            android:layout_marginTop="10dp"/>

<!--        Below is button number five  -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/start_exercise"
            android:text="🚴🏽‍♂️Start Exercise"
            android:textSize="20sp"
            android:backgroundTint="@color/cardview_dark_background"
            android:layout_marginTop="10dp"/>

<!--        Below is button number six-->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/daily_motivation"
            android:text="🎯Daily Motivation"
            android:textSize="20sp"
            android:backgroundTint="@color/cardview_dark_background"
            android:layout_marginTop="10dp"/>

<!--        Below is button number seven -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/weekly_goals"
            android:text="🗓️Weekly Goals"
            android:textSize="20sp"
            android:backgroundTint="@color/cardview_dark_background"
            android:layout_marginTop="10dp"/>

<!--        Below is button number seven   -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/check_progress"
            android:text="🛄Check Progress"
            android:textSize="20sp"
            android:backgroundTint="@color/cardview_dark_background"
            android:layout_marginTop="10dp"/>

<!--         Below is button number eight -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/learn_more"
                android:text="📥Learn More..."
                android:textSize="20sp"
                android:backgroundTint="@color/cardview_dark_background"
                android:layout_marginTop="10dp"/>




    </LinearLayout>


</ScrollView>