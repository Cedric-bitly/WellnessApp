<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#91D9AE"
    tools:context=".WeeklyGoalsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Weekly Goals"
            android:textSize="32sp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:background="@drawable/shape"
            android:padding="10dp"
            android:textColor="#0345D9"/>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:src="@drawable/image16"
            android:scaleType="centerCrop"/>

        <TextView
            android:id="@+id/weeklyGoalsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Weekly Wellness Goals\n\n1. Exercise Goal\nComplete 4-5 workout sessions this week.\n\n2. Hydration Goal\nDrink 8 glasses of water daily for 7 days.\n\n3. Sleep Goal\nGet 7-8 hours of quality sleep each night.\n\n4. Nutrition Goal\nEat 5 servings of fruits and vegetables daily.\n\n5. Meditation Goal\nPractice mindfulness for 10 minutes each day.\n\n6. Step Goal\nWalk 10,000 steps daily throughout the week.\n\n7. Screen Time Goal\nLimit screen time to 2 hours per day.\n\n8. Self-Care Goal\nDedicate 30 minutes daily for relaxation."
            android:textColor="#034509"
            android:textSize="16sp" />



    </LinearLayout>

</ScrollView>